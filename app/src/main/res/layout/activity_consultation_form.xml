<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1976D2"
        android:padding="16dp"
        android:text="Nouvelle consultation"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date de la consultation"
                android:textColor="#666666"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etCDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input"
                android:clickable="true"
                android:focusable="false"
                android:inputType="none"
                android:padding="12dp"
                android:textColor="#212121" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Motif de la consultation"
                android:textColor="#666666"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etMotif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input"
                android:hint="Ex : Fièvre et toux"
                android:inputType="textCapSentences"
                android:padding="12dp"
                android:textColor="#212121"
                android:textColorHint="#9E9E9E" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Diagnostic"
                android:textColor="#666666"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etDiag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input"
                android:gravity="top"
                android:hint="Ex : Grippe saisonnière"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="2"
                android:padding="12dp"
                android:textColor="#212121"
                android:textColorHint="#9E9E9E" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Traitement / ordonnance"
                android:textColor="#666666"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etTrait"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input"
                android:gravity="top"
                android:hint="Ex : Paracétamol 1 g, 3 fois par jour"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3"
                android:padding="12dp"
                android:textColor="#212121"
                android:textColorHint="#9E9E9E" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Honoraires (DT)"
                android:textColor="#666666"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etMontant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input"
                android:hint="Ex : 50"
                android:inputType="number"
                android:maxLength="5"
                android:padding="12dp"
                android:textColor="#212121"
                android:textColorHint="#9E9E9E" />

            <CheckBox
                android:id="@+id/cbPaye"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Consultation payée"
                android:textColor="#212121" />

            <Button
                android:id="@+id/btnCSave"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#1976D2"
                android:text="Enregistrer"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnCCancel"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#757575"
                android:text="Annuler"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
