<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1976D2"
        android:padding="16dp"
        android:text="Paramètres"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profil du médecin"
                android:textColor="#1976D2"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etDoctor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="Votre nom (ex : Ben Salah)"
                android:inputType="textPersonName|textCapWords"
                android:padding="12dp"
                android:textColor="#212121"
                android:textColorHint="#9E9E9E" />

            <Button
                android:id="@+id/btnSaveDoctor"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#1976D2"
                android:text="Enregistrer le nom"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Changer le mot de passe"
                android:textColor="#1976D2"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etOldPwd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="Ancien mot de passe"
                android:inputType="textPassword"
                android:padding="12dp"
                android:textColor="#212121"
                android:textColorHint="#9E9E9E" />

            <EditText
                android:id="@+id/etNewPwd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="Nouveau mot de passe"
                android:inputType="textPassword"
                android:padding="12dp"
                android:textColor="#212121"
                android:textColorHint="#9E9E9E" />

            <EditText
                android:id="@+id/etConfirmPwd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="Confirmer le mot de passe"
                android:inputType="textPassword"
                android:padding="12dp"
                android:textColor="#212121"
                android:textColorHint="#9E9E9E" />

            <Button
                android:id="@+id/btnSavePwd"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#1976D2"
                android:text="Modifier le mot de passe"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Données"
                android:textColor="#1976D2"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnExport"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#00897B"
                android:text="📤  Exporter les patients (CSV)"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnClear"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#D32F2F"
                android:text="🗑️  Supprimer toutes les données"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:text="Cabinet Médical v3 - Application Android (Java)"
                android:textColor="#9E9E9E"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
